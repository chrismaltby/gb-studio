{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",

    "module": "Node16",
    "moduleResolution": "node16",
    "moduleDetection": "force",

    "target": "ES2022",
    "types": ["node"],
    "esModuleInterop": true,

    "ignoreDeprecations": "6.0"
  },
  "ts-node": {
    "transpileOnly": true
  }
}