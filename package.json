{
  "name": "gb-studio",
  "productName": "GB Studio",
  "homepage": "https://www.gbstudio.dev",
  "bugs": {
    "url": "https://github.com/chrismaltby/gb-studio/issues"
  },
  "version": "4.3.2",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "description": "Visual retro game maker",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "cross-env NODE_ENV=production electron-forge package",
    "make:win": "cross-env NODE_ENV=production electron-forge make --arch=x64 --platform=win32",
    "make:win32": "cross-env NODE_ENV=production electron-forge make --arch=ia32 --platform=win32",
    "make:mac": "cross-env NODE_ENV=production electron-forge make --arch=arm64 --platform=darwin",
    "make:mac-intel": "cross-env NODE_ENV=production electron-forge make --arch=x64 --platform=darwin",
    "make:linux": "cross-env NODE_ENV=production electron-forge make --arch=x64 --platform=linux",
    "make:linux-arm64": "cross-env NODE_ENV=production electron-forge make --arch=arm64 --platform=linux",
    "make": "cross-env NODE_ENV=production electron-forge make",
    "lint": "eslint --cache --color src test",
    "prettier": "prettier --write src test",
    "test": "jest --maxWorkers=2",
    "coverage": "jest --coverage --runInBand",
    "missing-translations": "node src/lang/list_missing.js",
    "audit:music-web-l10n": "node src/apps/gbs-music-web/lang/auditMusicWebL10N.js",
    "make:cli": "webpack --config ./src/apps/gb-studio-cli/webpack.cli.config.js",
    "start:music-web": "cross-env NODE_ENV=development webpack serve --config src/apps/gbs-music-web/webpack.music.web.config.js",
    "build:music-web": "cross-env NODE_ENV=production webpack --config src/apps/gbs-music-web/webpack.music.web.config.js",
    "start:cli": "cross-env NO_TYPE_CHECKING=1 npm run make:cli && node out/cli/gb-studio-cli",
    "start:cli:profile": "cross-env NO_TYPE_CHECKING=1 npm run make:cli && time node --prof out/cli/gb-studio-cli",
    "flamegraph": "node --prof-process --preprocess -j isolate*.log | flamebearer",
    "analyze-bundle": "cross-env ANALYZE_BUNDLE=1 electron-forge start",
    "fetch-deps": "git submodule update --init --recursive && ts-node --project tsconfig.scripts.json src/scripts/fetchDependencies.ts",
    "fetch-contributors": "ts-node --project tsconfig.scripts.json src/scripts/fetchContributors.ts",
    "fetch-patrons": "ts-node --project tsconfig.scripts.json src/scripts/fetchPatrons.ts",
    "snapshotScriptEventDefs": "cross-env NODE_ENV=test NODE_PATH=src ts-node --project tsconfig.scripts.json src/scripts/snapshotScriptEventDefs.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "knip": "knip",
    "tsc": "tsc"
  },
  "keywords": [],
  "author": "GB Studio",
  "license": "MIT",
  "config": {
    "forge": "./src/apps/gb-studio/forge.config.js"
  },
  "bin": {
    "gb-studio-cli": "./out/cli/gb-studio-cli.js"
  },
  "dependencies": {
